---
import Container from '@/components/Container.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found" noindex>
  <Container>
    <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-muted">
      That page does not exist. Try the <a
        class="text-accent-strong underline underline-offset-4"
        href="/projects"
      >projects index</a>, or head <a
        class="text-accent-strong underline underline-offset-4"
        href="/"
      >home</a>.
    </p>
  </Container>
</BaseLayout>
