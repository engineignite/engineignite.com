---
import PageLayout from '@/layouts/PageLayout.astro'
import { getLegal, getProjects, legalOwner } from '@/lib/content'
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'

export const getStaticPaths = (async () => {
  const projects = await getProjects()
  const projectIds = new Set(projects.map((project) => project.id))
  const entries = await getLegal()

  return entries
    .filter((entry) => projectIds.has(legalOwner(entry)))
    .map((entry) => {
      const project = projects.find((candidate) => candidate.id === legalOwner(entry))!
      return {
        params: { project: project.id, kind: entry.data.kind },
        props: { entry, project },
      }
    })
}) satisfies GetStaticPaths

const { entry, project } = Astro.props
const { Content } = await render(entry)
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description ?? `${entry.data.title} for ${project.data.title}.`}
  ogImage={`/og/projects/${project.id}.png`}
  eyebrow={project.data.title}
  updated={entry.data.updated}
  noindex={entry.data.draft || project.data.draft}
>
  <Content />
</PageLayout>
