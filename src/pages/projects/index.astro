---
import Container from '@/components/Container.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getProjects } from '@/lib/content'

const projects = await getProjects()
---

<BaseLayout
  title="Projects"
  description="Apps and tools built by Engine Ignite, with support and documentation for each."
>
  <Container>
    <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Projects</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Every project has its own page with support contacts, terms, and privacy policy.
    </p>

    {projects.length > 0
      ? (
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      )
      : <p class="mt-10 text-muted">No projects are published yet.</p>}
  </Container>
</BaseLayout>
