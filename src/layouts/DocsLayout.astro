---
import Container from '@/components/Container.astro'
import DocsSidebar from '@/components/DocsSidebar.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Doc, Project } from '@/lib/content'

interface Props {
  project: Project
  docs: Doc[]
  entry: Doc
  noindex?: boolean
}

const { project, docs, entry, noindex = false } = Astro.props
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? project.data.tagline}
  ogImage={`/og/projects/${project.id}.png`}
  type="article"
  noindex={noindex}
  updated={entry.data.updated}
  bare
>
  <Container width="wide" class="py-12">
    <div class="grid gap-10 md:grid-cols-[16rem_1fr]">
      <aside class="md:sticky md:top-24 md:self-start">
        <DocsSidebar project={project} docs={docs} currentId={entry.id} />
      </aside>

      <article>
        <nav class="mb-4 text-sm text-muted" aria-label="Breadcrumb">
          <a class="hover:text-fg" href={`/projects/${project.id}`}>{project.data.title}</a>
          <span aria-hidden="true"> / </span>
          <span>Docs</span>
        </nav>

        <h1 class="text-3xl font-semibold tracking-tight text-balance text-fg">
          {entry.data.title}
        </h1>
        {entry.data.description && <p class="mt-3 text-lg text-muted">{entry.data.description}</p>}

        <div class="prose mt-8 max-w-none">
          <slot />
        </div>
      </article>
    </div>
  </Container>
</BaseLayout>
