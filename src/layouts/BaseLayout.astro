---
import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/site.config'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  ogImage?: string
  type?: 'website' | 'article'
  noindex?: boolean
  updated?: Date | undefined
  /** Docs pages render their own full-width shell. */
  bare?: boolean
}

const { bare = false, ...head } = Astro.props
---

<!DOCTYPE html>
<html lang={SITE.locale} class="scroll-pt-20">
  <head>
    <BaseHead {...head} />
    <script is:inline>
      // Applied before first paint so the theme never flashes.
      try {
        const stored = localStorage.getItem('theme')
        const dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
      } catch {
        // Ignore: storage blocked, fall back to the light theme.
      }
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-accent px-4 py-2 text-accent-fg focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class:list={['flex-1', bare ? '' : 'py-12 sm:py-16']}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
