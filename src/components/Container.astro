---
interface Props {
  class?: string
  /** `prose` narrows the column for reading; `wide` fits a docs sidebar. */
  width?: 'default' | 'prose' | 'wide'
}

const { class: className = '', width = 'default' } = Astro.props
// The design canvas is 1200px; treat that as the content cap.
const max = { prose: 'max-w-[46rem]', wide: 'max-w-[1200px]', default: 'max-w-[1200px]' }[width]
---

<div class:list={['mx-auto w-full px-5 sm:px-8', max, className]}>
  <slot />
</div>
