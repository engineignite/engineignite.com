---
import Badge from '@/components/Badge.astro'
import { PLATFORM_LABELS, type Project, STATUS_LABELS } from '@/lib/content'

interface Props {
  project: Project
}

const { project } = Astro.props
const { title, tagline, status, platforms, draft } = project.data
---

<a
  href={`/projects/${project.id}`}
  class="group flex flex-col gap-3 rounded-xl border border-border bg-surface p-6 transition-colors hover:border-accent"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold tracking-tight text-fg group-hover:text-accent-strong">
      {title}
    </h3>
    <Badge tone={status === 'live' ? 'accent' : 'neutral'}>{STATUS_LABELS[status]}</Badge>
  </div>

  <p class="text-sm text-muted">{tagline}</p>

  <div class="mt-auto flex flex-wrap items-center gap-2 pt-2 text-xs text-muted">
    {platforms.map((platform) => <span>{PLATFORM_LABELS[platform]}</span>)}
    {draft && <Badge>Draft</Badge>}
  </div>
</a>
