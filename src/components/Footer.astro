---
import { SITE } from '@/site.config'

const year = new Date().getFullYear()
---

<footer class="rule mt-16 border-t-2 bg-panel">
  <div class="mono-label text-ink/55 mx-auto flex w-full max-w-[1200px] flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-5 tracking-[0.06em] sm:px-8">
    <span>{SITE.name} · EI-01</span>

    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Footer">
      <a class="hover:text-accent transition-colors" href={SITE.cta.href}>{SITE.email}</a>
      <a class="hover:text-accent transition-colors" href={SITE.social.github}>GitHub</a>
      <a class="hover:text-accent transition-colors" href="/rss.xml">RSS</a>
    </nav>

    <span>&copy; {year}</span>
  </div>
</footer>
