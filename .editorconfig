root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Preserve markdown hard line breaks (two trailing spaces)
trim_trailing_whitespace = false

[*.{ts,tsx,js,mjs,cjs,json,jsonc,json5,astro,css,html,yaml,yml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
